// Prisma schema (draft) matching PRD

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String    @id @default(uuid())
  phone              String    @unique
  username           String    @unique
  time_zone          String
  avatar             Bytes?
  avatar_mime_type   String?
  avatar_updated_at  DateTime? @db.Timestamptz(6)
  notify_sound       Boolean   @default(true)
  notify_vibrate     Boolean   @default(true)
  notify_break_focus Boolean   @default(false)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  owned_groups              Group[]                 @relation("GroupOwner")
  members                   GroupMember[]
  devices                   PushDevice[]
  call_participants         CallParticipant[]
  created_invites           Invite[]                @relation("InviteCreator")
  used_invites              Invite[]                @relation("InviteUser")
  received_invites          Invite[]                @relation("InvitedUser")
  live_activity_push_tokens CallLiveActivityToken[]
}

enum Cadence {
  daily
  weekly
}

enum Role {
  owner
  member
}

enum CallStatus {
  scheduled
  activating
  active
  ended
}

enum CallType {
  spontaneous
  scheduled
}

model Group {
  id                    String        @id @default(uuid())
  name                  String
  owner_id              String
  owner                 User          @relation("GroupOwner", fields: [owner_id], references: [id])
  cadence               Cadence
  daily_frequency       Int?
  weekly_frequency      Int?
  call_duration_minutes Int           @default(30)
  time_zone             String        @default("UTC") // IANA tz for this group's call window
  call_window_start     Int           @default(6)   // Hour (0–23) in group's time_zone
  call_window_end       Int           @default(22)  // Hour (0–23) exclusive, in group's time_zone
  created_at            DateTime      @default(now()) @db.Timestamptz(6)

  // Relations
  members GroupMember[]
  calls   CallSession[]
  invites Invite[]

  @@index([owner_id])
}

model GroupMember {
  id        String   @id @default(uuid())
  group_id  String
  user_id   String
  role      Role
  is_muted  Boolean  @default(false)
  joined_at DateTime @default(now()) @db.Timestamptz(6)

  // Relations
  group Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([group_id, user_id])
  @@index([user_id])
  @@index([group_id])
}

model CallSession {
  id                    String     @id @default(uuid())
  group_id              String
  status                CallStatus
  call_type             CallType   @default(spontaneous)
  scheduled_at          DateTime?  @db.Timestamptz(6)
  scheduled_day         String?    // 'YYYY-MM-DD' in SCHEDULE_TZ; null for spontaneous calls
  claimed_at            DateTime?  @db.Timestamptz(6)
  started_at            DateTime?  @db.Timestamptz(6)
  ends_at               DateTime?  @db.Timestamptz(6)
  ended_at              DateTime?  @db.Timestamptz(6)
  room_name             String?
  room_url              String?
  live_activity_tokens  Json?

  // Relations
  group                     Group                   @relation(fields: [group_id], references: [id], onDelete: Cascade)
  participants              CallParticipant[]
  live_activity_push_tokens CallLiveActivityToken[]

  @@index([group_id])
  @@index([status])
  @@index([call_type])
  @@index([scheduled_at])
  @@index([scheduled_day])
}

model CallParticipant {
  id           String    @id @default(uuid())
  call_id      String
  user_id      String
  joined_at    DateTime  @default(now()) @db.Timestamptz(6)
  left_at      DateTime? @db.Timestamptz(6)
  last_seen_at DateTime? @db.Timestamptz(6)

  // Relations
  call CallSession @relation(fields: [call_id], references: [id], onDelete: Cascade)
  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([call_id])
  @@index([user_id])
}

// Per-activity Live Activity push token: addresses one running activity on one device.
// A table rather than a column on CallSession because a Json column is a read-modify-write
// lost-update hazard when multiple devices register concurrently at call start.
model CallLiveActivityToken {
  id         String   @id @default(uuid())
  call_id    String
  user_id    String
  push_token String
  updated_at DateTime @updatedAt @db.Timestamptz(6)

  call CallSession @relation(fields: [call_id], references: [id], onDelete: Cascade)
  user User        @relation(fields: [user_id], references: [id], onDelete: Cascade)

  // Keyed on push_token, not user_id: a rotated token lands as a second row rather than
  // replacing the first. Deliberately not fixed here — stage 8's fan-out already deletes a
  // row when APNs returns BadDeviceToken/Unregistered for it, so a stale row from rotation
  // self-heals at the next broadcast. Do not add a second cleanup mechanism for this.
  @@unique([call_id, push_token])
  @@index([call_id])
}

model PushDevice {
  id                      String    @id @default(uuid())
  user_id                 String
  token                   String
  platform                String
  live_activity_pts_token String?
  pts_updated_at          DateTime? @db.Timestamptz(6)
  created_at              DateTime  @default(now()) @db.Timestamptz(6)

  // Relations
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([user_id])
  @@index([live_activity_pts_token])
}

enum InviteStatus {
  pending
  accepted
  declined
  dismissed
}

model Invite {
  id               String        @id @default(uuid())
  group_id         String
  code             String?       @unique // Nullable for direct invites
  created_by       String
  created_at       DateTime      @default(now()) @db.Timestamptz(6)
  expires_at       DateTime      @db.Timestamptz(6)
  used_by          String?
  used_at          DateTime?     @db.Timestamptz(6)
  max_uses         Int?          // null = unlimited
  use_count        Int           @default(0)
  revoked_at       DateTime?     @db.Timestamptz(6)
  invited_user_id  String?       // For direct username-based invites
  status           InviteStatus? // For tracking invite state
  responded_at     DateTime?     @db.Timestamptz(6)

  // Relations
  group        Group @relation(fields: [group_id], references: [id], onDelete: Cascade)
  creator      User  @relation("InviteCreator", fields: [created_by], references: [id])
  user         User? @relation("InviteUser", fields: [used_by], references: [id])
  invited_user User? @relation("InvitedUser", fields: [invited_user_id], references: [id])

  @@index([group_id])
  @@index([code])
  @@index([expires_at])
  @@index([invited_user_id])
  @@index([status])
}

