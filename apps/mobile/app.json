{
  "expo": {
    "name": "Orbit",
    "slug": "orbit",
    "scheme": "orbit",
    "version": "0.1.0",
    "icon": "./assets/icon.png",
    "orientation": "portrait",
    "updates": {
      "enabled": true
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.mylesharris.orbit",
      "bitcode": false,
      "infoPlist": {
        "NSCameraUsageDescription": "Orbit needs camera access for video calls",
        "NSMicrophoneUsageDescription": "Orbit needs microphone access for video calls",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": ["audio", "voip"],
        "NSSupportsLiveActivities": true,
        "NSSupportsLiveActivitiesFrequentUpdates": true
      },
      "entitlements": {
        "com.apple.developer.usernotifications.time-sensitive": true
      }
    },
    "android": {
      "package": "com.mylesharris.orbit",
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "MODIFY_AUDIO_SETTINGS",
        "USE_FULL_SCREEN_INTENT",
        "VIBRATE"
      ]
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "sounds": ["./assets/sounds/orbit_ring.wav"]
        }
      ],
      "@daily-co/config-plugin-rn-daily-js",
      "expo-font",
      "./withPip",
      ["@bacons/apple-targets", { "appleTeamId": "4B85QC9P6S" }],
      [
        "expo-build-properties",
        {
          "ios": { "deploymentTarget": "17.2" }
        }
      ],
      "./withCallNotificationService",
      "expo-localization"
    ],
    "extra": {
      "eas": {
        "projectId": "8bfe8018-2ae5-4dbb-b0d4-a9a3ed5ffe6a"
      }
    }
  }
}
