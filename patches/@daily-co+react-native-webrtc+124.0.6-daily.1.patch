+- (void)orbitTearDownMultiCam API_AVAILABLE(ios(13.0)) {
+    [self.backOutput setSampleBufferDelegate:nil queue:nil];
+    [self.frontOutput setSampleBufferDelegate:nil queue:nil];
+    [self.multiCamSession stopRunning];
+    self.multiCamSession = nil;
+    self.frontOutput = nil;
+    self.backOutput = nil;
+    self.multiCamRunning = NO;
+}
