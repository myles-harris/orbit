+// we actually care about — are frames arriving — and rebuild if they are not. Bounded, so
+// a genuinely unavailable camera degrades to the single-cam fallback instead of looping.
+- (void)orbitScheduleMultiCamFrameWatchdog API_AVAILABLE(ios(13.0)) {
+    __weak VideoCaptureController *weakSelf = self;
+    dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 800 * NSEC_PER_MSEC), self.orbitSwapQueue, ^{
+        VideoCaptureController *strongSelf = weakSelf;
+        if (!strongSelf) {
+            return;
+        }
+        @synchronized(strongSelf) {
+            // Orbit: `running` NO means the local camera is intentionally off — stopCapture
+            // soft-stops multicam, leaving multiCamRunning YES while frames are discarded.
+            // Without this check the watchdog sees "session up, zero delivered" and rebuilds
+            // the session every cycle for as long as the user has their video muted.
+            if (!strongSelf.multiCamRunning || !strongSelf.running ||
+                strongSelf.orbitFramesDelivered > 0) {
+                strongSelf.orbitMultiCamAttempt = 0;
+                return;
+            }
+            if (strongSelf.orbitMultiCamAttempt >= 3) {
+                NSLog(@"[Orbit][MultiCam] still no frames after %lu rebuilds — falling back to "
+                      @"single-cam for this call",
