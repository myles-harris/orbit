+        }
+        // Orbit: tear down, then let the capture server actually release the sources before
+        // asking for them again. Rebuilding synchronously here would re-enter the same race
+        // that produced the empty session in the first place. Outside the lock so the queue
+        // is free while we wait.
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 400 * NSEC_PER_MSEC),
+                       strongSelf.orbitSwapQueue, ^{
