+- (void)startMultiCamSession API_AVAILABLE(ios(13.0)) {
+    // Orbit: evict any previous owner before touching the hardware. See the note on
+    // sOrbitActiveMultiCamOwner — a soft-stopped session from a finished call still holds
+    // both cameras, and building a second one on top of it yields a session that starts
+    // cleanly and then delivers nothing.
+    VideoCaptureController *previousOwner = nil;
+    @synchronized([VideoCaptureController class]) {
+        previousOwner = sOrbitActiveMultiCamOwner;
+        sOrbitActiveMultiCamOwner = self;
+    }
+    if (previousOwner && previousOwner != self) {
+        NSLog(@"[Orbit][MultiCam] releasing cameras held by a previous controller");
+        @synchronized(previousOwner) {
+            [previousOwner orbitTearDownMultiCam];
+            previousOwner.running = NO;
+        }
+    }
+
+    AVCaptureDevice *frontDev = [self findDeviceForPosition:AVCaptureDevicePositionFront];
+    AVCaptureDevice *backDev  = [self findDeviceForPosition:AVCaptureDevicePositionBack];
+    if (!frontDev || !backDev) {
+        NSLog(@"[Orbit][MultiCam] Could not find both cameras — falling back to single-cam");
+        return;
+    }
+
+    self.frontDevice = frontDev;
+    self.backDevice  = backDev;
+
+    // Orbit: force both cameras onto a multicam-legal activeFormat BEFORE building the
+    // session. This is not defensive tidying — without it the whole thing fails:
+    //
+    //   RTCCameraVideoCapturer.startCaptureWithDevice:format: (the single-cam path we run
+    //   while backgrounded) sets activeFormat to a format chosen purely by resolution,
+    //   which on the back camera is NOT multicam-supported. That setting is a property of
+    //   the shared AVCaptureDevice and outlives the session. Coming back to the foreground,
+    //   canAddInput: still returns YES — AVFoundation raises no objection at configuration
+    //   time — and then startRunning fails at runtime with
+    //   AVFoundationErrorDomain -11873 "The camera's active format is unsupported by this
+    //   session", isRunning stays NO, and not one frame is ever delivered.
+    //
+    // Which is exactly what the recovery suggestion in that error says to do: reset the
+    // camera to a supported active format, then start the session. main never needed this
+    // because main never runs the single-cam path at all.
+    AVCaptureDeviceFormat *backFmt  = [self orbitMultiCamFormatForDevice:backDev];
+    AVCaptureDeviceFormat *frontFmt = [self orbitMultiCamFormatForDevice:frontDev];
+    if (!backFmt || !frontFmt) {
+        NSLog(@"[Orbit][MultiCam] no multicam-capable format on %@ — falling back to single-cam",
+              !backFmt ? @"back camera" : @"front camera");
+        return;
+    }
