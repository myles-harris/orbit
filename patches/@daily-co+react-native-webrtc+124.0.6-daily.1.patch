+    // Daily.co's JS layer handles front-camera mirroring via DailyMediaView's `mirror` prop.
+    RTCVideoFrame *frame = [[RTCVideoFrame alloc] initWithBuffer:rtcBuffer
+                                                        rotation:RTCVideoRotation_90
+                                                     timeStampNs:timeStampNs];
