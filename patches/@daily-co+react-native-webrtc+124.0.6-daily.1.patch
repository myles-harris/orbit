+- (void)orbitStopSingleCam {
+    AVCaptureSession *session = self.capturer.captureSession;
+
+    // Orbit: clear multitasking camera access BEFORE stopping. That flag is precisely the
+    // statement "this session may hold the camera even when the app is not foreground", so
+    // leaving it set on a session we are about to abandon is asking iOS to keep the claim
+    // alive. This is the leading candidate for why every multicam session built after the
+    // first one starts cleanly and then delivers nothing: the flag is only ever set once we
+    // have been backgrounded, which is exactly when the pattern begins.
+    if (@available(iOS 16.0, *)) {
+        if (session.multitaskingCameraAccessEnabled) {
+            [session beginConfiguration];
+            [session setMultitaskingCameraAccessEnabled:NO];
+            [session commitConfiguration];
+        }
+    }
+
+    dispatch_semaphore_t semaphore = dispatch_semaphore_create(0);
+    [self.capturer stopCaptureWithCompletionHandler:^{
+        dispatch_semaphore_signal(semaphore);
+    }];
+    dispatch_semaphore_wait(semaphore, DISPATCH_TIME_FOREVER);
+
+    // Orbit: report what the abandoned session is still holding. If inputs is non-zero or
+    // isRunning is YES here, the camera has not been released and no amount of retrying the
+    // multicam build will help — the fix would be to stop routing background capture through
+    // RTCCameraVideoCapturer at all and own that session ourselves.
+    NSLog(@"[Orbit][Swap] single-cam stopped — isRunning=%d inputs=%lu outputs=%lu",
+          session.isRunning, (unsigned long)session.inputs.count,
+          (unsigned long)session.outputs.count);
+
+    self.device = nil;
+    self.deviceId = nil;
+}
