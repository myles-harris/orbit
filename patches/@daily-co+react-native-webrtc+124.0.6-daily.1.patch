+    AVCaptureInputPort *backPort = [[backInput portsWithMediaType:AVMediaTypeVideo
+                                                sourceDeviceType:backDev.deviceType
+                                            sourceDevicePosition:AVCaptureDevicePositionBack] firstObject];
+    if (!backPort) {
