+- (void)captureSessionDidStartRunning:(NSNotification *)notification {
+    AVCaptureSession *session = self.capturer.captureSession;
+    for (AVCaptureConnection *conn in session.connections) {
+        // Force software-only stabilization to prevent OIS oscillation on back camera.
+        // AVCaptureVideoStabilizationModeAuto can select cinematic modes that conflict
+        // with hardware OIS. Front camera has no OIS so isVideoStabilizationSupported
+        // is false there — this is a safe no-op for front camera.
+        if (conn.isVideoStabilizationSupported) {
+            conn.preferredVideoStabilizationMode = AVCaptureVideoStabilizationModeStandard;
+        }
+        // Explicitly set mirroring instead of relying on automaticallyAdjustsVideoMirroring,
+        // which applies asynchronously and causes a brief inverted frame on camera switch.
+        if (conn.isVideoMirroringSupported) {
+            conn.automaticallyAdjustsVideoMirroring = NO;
+            conn.videoMirrored = self.usingFrontCamera;
+        }
+    }
+}
