+#pragma mark Orbit foreground/background session swap
+
+// Orbit: the two session types have complementary limitations, so we run whichever one
+// fits the moment.
+//
+//   multicam   — both cameras stay attached for the life of the session and a flip is a
+//                bool plus per-frame filtering, so no capture source is ever re-acquired.
+//                This is what keeps the back camera from oscillating, and it is what ships
+//                on main. It cannot capture while backgrounded.
+//   single-cam — honours multitaskingCameraAccessEnabled, so frames keep arriving while
+//                backgrounded, which is the only source of content for solo PiP. A flip
+//                re-acquires the capture source, which is what makes the back camera shake.
+//
+// Nobody flips the camera while the app is backgrounded, and a re-acquisition that happens
+// during the background transition is not one the user is watching, so the two limitations
+// cancel out. Crucially this is one swap per background transition, never one per flip.
+- (void)orbitObserveAppState {
+    NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+    [nc addObserver:self
+           selector:@selector(orbitAppWillResignActive:)
+               name:UIApplicationWillResignActiveNotification
+             object:nil];
+    [nc addObserver:self
+           selector:@selector(orbitAppDidBecomeActive:)
+               name:UIApplicationDidBecomeActiveNotification
+             object:nil];
+
+    // Orbit: seed from the real application state rather than assuming foreground. A
+    // controller is created per getUserMedia, so one can be created while the app is
+    // ALREADY backgrounded — a call answered from a push or the Live Activity does exactly
+    // that, and willResignActive fired before this object existed. Assuming foreground
+    // there would build a multicam session in the background, which iOS immediately
+    // interrupts, blanking PiP on the one launch path where it matters most.
+    __weak VideoCaptureController *weakSelf = self;
+    dispatch_async(dispatch_get_main_queue(), ^{
+        VideoCaptureController *strongSelf = weakSelf;
+        if (!strongSelf) {
+            return;
+        }
+        if ([UIApplication sharedApplication].applicationState != UIApplicationStateActive) {
+            NSLog(@"[Orbit][Swap] controller created while backgrounded — single-cam only");
+            strongSelf.orbitBackgrounded = YES;
+        }
+    });
+}
+
+- (void)orbitAppWillResignActive:(NSNotification *)notification {
+    // Orbit: off the main thread — the single-cam start below blocks on a semaphore for a
+    // few hundred ms, and stalling willResignActive stalls the system transition.
+    // WillResignActive rather than DidEnterBackground so the single-cam session is already
+    // running by the time iOS backgrounds us, rather than trying to start capture from a
+    // state where it may be refused.
+    __weak VideoCaptureController *weakSelf = self;
+    dispatch_async(self.orbitSwapQueue, ^{
+        VideoCaptureController *strongSelf = weakSelf;
+        if (!strongSelf) {
+            return;
+        }
+        @synchronized(strongSelf) {
+            if (strongSelf.orbitBackgrounded) {
+                return;
+            }
+            strongSelf.orbitBackgrounded = YES;
+            if (@available(iOS 13.0, *)) {
+                if (!strongSelf.running || !strongSelf.multiCamRunning) {
+                    return;
+                }
+                NSLog(@"[Orbit][Swap] backgrounding -> single-cam (background capture)");
+                [strongSelf orbitTearDownMultiCam];
+                strongSelf.device = nil;
+                strongSelf.deviceId = nil;
+                [strongSelf orbitStartCaptureLocked];
+            }
+        }
+    });
+}
+
+- (void)orbitAppDidBecomeActive:(NSNotification *)notification {
+    __weak VideoCaptureController *weakSelf = self;
+    dispatch_async(self.orbitSwapQueue, ^{
+        VideoCaptureController *strongSelf = weakSelf;
+        if (!strongSelf) {
+            return;
+        }
+        @synchronized(strongSelf) {
+            if (!strongSelf.orbitBackgrounded) {
+                return;
+            }
+            strongSelf.orbitBackgrounded = NO;
+            if (@available(iOS 13.0, *)) {
+                if (!strongSelf.running || strongSelf.multiCamRunning) {
+                    return;
+                }
+                if (![AVCaptureMultiCamSession isMultiCamSupported]) {
+                    return;
+                }
+                NSLog(@"[Orbit][Swap] foregrounding -> multicam (warm both cameras)");
+                [strongSelf orbitStopSingleCam];
+                [strongSelf orbitStartCaptureLocked];
+            }
+        }
+    });
+}
