+    AVCaptureMultiCamSession *session = [[AVCaptureMultiCamSession alloc] init];
+    NSError *err = nil;
+
+    // Back camera input
+    AVCaptureDeviceInput *backInput = [AVCaptureDeviceInput deviceInputWithDevice:backDev error:&err];
+    if (!backInput || err) {
+        NSLog(@"[Orbit][MultiCam] Failed to create back camera input: %@", err);
+        return;
+    }
+    if (![session canAddInput:backInput]) {
+        NSLog(@"[Orbit][MultiCam] Cannot add back camera input");
+        return;
+    }
+    [session addInputWithNoConnections:backInput];
+
+    // Front camera input
+    err = nil;
+    AVCaptureDeviceInput *frontInput = [AVCaptureDeviceInput deviceInputWithDevice:frontDev error:&err];
+    if (!frontInput || err) {
+        NSLog(@"[Orbit][MultiCam] Failed to create front camera input: %@", err);
+        return;
+    }
+    if (![session canAddInput:frontInput]) {
+        NSLog(@"[Orbit][MultiCam] Cannot add front camera input");
+        return;
+    }
+    [session addInputWithNoConnections:frontInput];
+
+    if (!self.captureQueue) {
+        self.captureQueue = dispatch_queue_create("com.orbit.multicam.capture", DISPATCH_QUEUE_SERIAL);
+    }
