+// AVCaptureVideoDataOutputSampleBufferDelegate
+- (void)captureOutput:(AVCaptureOutput *)output
+    didOutputSampleBuffer:(CMSampleBufferRef)sampleBuffer
+       fromConnection:(AVCaptureConnection *)connection {
+    if (!self.running || !self.capturer.delegate) return;
+
+    // Only forward frames from the currently active camera.
+    // The other camera's frames are silently discarded.
+    BOOL isFrontOutput = (output == self.frontOutput);
+    if (isFrontOutput != self.usingFrontCamera) return;
+
+    CVPixelBufferRef pixelBuffer = CMSampleBufferGetImageBuffer(sampleBuffer);
+    if (!pixelBuffer) return;
+
+    RTCCVPixelBuffer *rtcBuffer = [[RTCCVPixelBuffer alloc] initWithPixelBuffer:pixelBuffer];
+    CMTime ts = CMSampleBufferGetPresentationTimeStamp(sampleBuffer);
+    int64_t timeStampNs = (int64_t)(CMTimeGetSeconds(ts) * NSEC_PER_SEC);
+
+    // Camera sensor outputs in landscape; rotate 90° clockwise to display upright in portrait.
+    // Daily.co's JS layer handles front-camera mirroring via DailyMediaView's `mirror` prop.
+    RTCVideoFrame *frame = [[RTCVideoFrame alloc] initWithBuffer:rtcBuffer
+                                                        rotation:RTCVideoRotation_90
+                                                     timeStampNs:timeStampNs];
+    [self.capturer.delegate capturer:self.capturer didCaptureVideoFrame:frame];
+}
