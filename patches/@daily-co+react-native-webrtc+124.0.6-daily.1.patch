diff --git a/node_modules/@daily-co/react-native-webrtc/ios/RCTWebRTC/VideoCaptureController.m b/node_modules/@daily-co/react-native-webrtc/ios/RCTWebRTC/VideoCaptureController.m
index 532276a..16a25f3 100644
--- a/node_modules/@daily-co/react-native-webrtc/ios/RCTWebRTC/VideoCaptureController.m
+++ b/node_modules/@daily-co/react-native-webrtc/ios/RCTWebRTC/VideoCaptureController.m
@@ -90,6 +90,26 @@ - (void)startCapture {
                             } else {
                                 RCTLog(@"[VideoCaptureController] Capture started");
                                 weakSelf.running = YES;
+                                // Defer the stabilization fix to the main queue after a short delay.
+                                // AVFoundation can reset connection properties asynchronously after
+                                // commitConfiguration (e.g. on camera switches), so applying the fix
+                                // inline in this handler races with that work. 300ms is enough for
+                                // all post-start session configuration to complete.
+                                // AVCaptureVideoStabilizationModeAuto can select cinematic modes that
+                                // conflict with hardware OIS on the back camera, causing oscillation.
+                                // isVideoStabilizationSupported is false on the front camera so this
+                                // is a safe no-op when on front camera.
+                                dispatch_after(
+                                    dispatch_time(DISPATCH_TIME_NOW, (int64_t)(300 * NSEC_PER_MSEC)),
+                                    dispatch_get_main_queue(),
+                                    ^{
+                                        AVCaptureSession *session = weakSelf.capturer.captureSession;
+                                        for (AVCaptureConnection *conn in session.connections) {
+                                            if (conn.isVideoStabilizationSupported) {
+                                                conn.preferredVideoStabilizationMode = AVCaptureVideoStabilizationModeStandard;
+                                            }
+                                        }
+                                    });
                             }
                             dispatch_semaphore_signal(semaphore);
                         }];
