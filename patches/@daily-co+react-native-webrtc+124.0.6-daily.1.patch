+// Orbit: smallest multicam-legal format that still covers the requested size. Only formats
+// reporting isMultiCamSupported may be active while a multicam session runs, and the
+// smallest sufficient one keeps hardwareCost down — two cameras at once is what makes that
+// budget tight.
+- (AVCaptureDeviceFormat *)orbitMultiCamFormatForDevice:(AVCaptureDevice *)device API_AVAILABLE(ios(13.0)) {
+    AVCaptureDeviceFormat *best = nil;
+    int bestPixels = INT_MAX;
+    for (AVCaptureDeviceFormat *format in device.formats) {
+        if (!format.isMultiCamSupported) {
+            continue;
+        }
+        CMVideoDimensions dim = CMVideoFormatDescriptionGetDimensions(format.formatDescription);
+        if (dim.width < self.width || dim.height < self.height) {
+            continue;
+        }
+        int pixels = dim.width * dim.height;
+        if (pixels < bestPixels) {
+            bestPixels = pixels;
+            best = format;
+        }
+    }
+    if (best) {
+        return best;
+    }
+    // Nothing large enough — take the largest multicam-legal format there is.
+    bestPixels = 0;
+    for (AVCaptureDeviceFormat *format in device.formats) {
+        if (!format.isMultiCamSupported) {
+            continue;
+        }
+        CMVideoDimensions dim = CMVideoFormatDescriptionGetDimensions(format.formatDescription);
+        int pixels = dim.width * dim.height;
+        if (pixels > bestPixels) {
+            bestPixels = pixels;
+            best = format;
+        }
+    }
+    return best;
+}
+
+- (void)orbitApplyMultiCamFormat:(AVCaptureDeviceFormat *)format
+                        toDevice:(AVCaptureDevice *)device API_AVAILABLE(ios(13.0)) {
+    if (!format || !device) {
+        return;
+    }
+    if (device.activeFormat == format) {
+        return;
+    }
+    NSError *lockErr = nil;
+    if (![device lockForConfiguration:&lockErr]) {
+        NSLog(@"[Orbit][MultiCam] could not lock %@ camera to reset format: %@",
+              device.position == AVCaptureDevicePositionFront ? @"front" : @"back", lockErr);
+        return;
+    }
+    device.activeFormat = format;
+    // Orbit: deliberately NOT touching activeVideoMin/MaxFrameDuration.
+    // setActiveVideoMinFrameDuration: raises NSInvalidArgumentException — an uncatchable
+    // crash, not an error return — if the value falls outside the newly-assigned format's
+    // supported ranges, and self.frameRate comes from JS constraints we do not control.
+    // Pinning the max duration would also stop the exposure engine lengthening exposure in
+    // low light, trading a dark noisy picture for a frame rate nobody asked to guarantee.
+    [device unlockForConfiguration];
+
+    CMVideoDimensions dim = CMVideoFormatDescriptionGetDimensions(format.formatDescription);
+    NSLog(@"[Orbit][MultiCam] reset %@ camera to multicam-legal %dx%d",
+          device.position == AVCaptureDevicePositionFront ? @"front" : @"back",
+          dim.width, dim.height);
+}
