+                [strongSelf orbitTearDownMultiCam];
+                strongSelf.device = nil;
+                strongSelf.deviceId = nil;
+                // Latched for the rest of this controller's life, not just this call to
+                // startCapture: if multicam cannot deliver on this device right now, a
+                // camera flip should not quietly try it again and blank the view.
+                strongSelf.orbitForceSingleCam = YES;
+                [strongSelf orbitStartCaptureLocked];
+                return;
+            }
+            strongSelf.orbitMultiCamAttempt += 1;
+            NSLog(@"[Orbit][MultiCam] no frames 800ms after start — rebuilding (attempt %lu)",
+                  (unsigned long)strongSelf.orbitMultiCamAttempt);
