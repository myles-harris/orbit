+    FourCharCode pixelFormat = [self.capturer preferredOutputPixelFormat];
+
+    // Back camera output
+    AVCaptureVideoDataOutput *backOut = [[AVCaptureVideoDataOutput alloc] init];
+    backOut.videoSettings = @{(id)kCVPixelBufferPixelFormatTypeKey: @(pixelFormat)};
+    backOut.alwaysDiscardsLateVideoFrames = YES;
