+#pragma mark Orbit capture-session diagnostics
+
+// Orbit: nothing in ios/RCTWebRTC observed capture-session interruptions, so
+// AVCaptureSessionInterruptionReasonVideoDeviceNotAvailableInBackground — the exact
+// condition that blanks solo PiP — was invisible. Registered per session; dealloc removes
+// this object from the centre entirely.
+- (void)orbitObserveCaptureSessionNotifications:(AVCaptureSession *)session {
+    if (!session) {
+        return;
+    }
+    NSNotificationCenter *nc = [NSNotificationCenter defaultCenter];
+    [nc removeObserver:self name:AVCaptureSessionWasInterruptedNotification object:nil];
+    [nc removeObserver:self name:AVCaptureSessionInterruptionEndedNotification object:nil];
+    [nc removeObserver:self name:AVCaptureSessionRuntimeErrorNotification object:nil];
+    [nc addObserver:self
+           selector:@selector(orbitCaptureSessionWasInterrupted:)
+               name:AVCaptureSessionWasInterruptedNotification
+             object:session];
+    [nc addObserver:self
+           selector:@selector(orbitCaptureSessionInterruptionEnded:)
+               name:AVCaptureSessionInterruptionEndedNotification
+             object:session];
+    [nc addObserver:self
+           selector:@selector(orbitCaptureSessionRuntimeError:)
+               name:AVCaptureSessionRuntimeErrorNotification
+             object:session];
+}
+
+- (void)orbitCaptureSessionWasInterrupted:(NSNotification *)notification {
+    NSInteger reason = [notification.userInfo[AVCaptureSessionInterruptionReasonKey] integerValue];
+    NSLog(@"[Orbit][Capture] session INTERRUPTED reason=%ld%@", (long)reason,
+          reason == AVCaptureSessionInterruptionReasonVideoDeviceNotAvailableInBackground
+              ? @" (VideoDeviceNotAvailableInBackground — multitasking camera access is NOT in effect)"
+              : @"");
+}
+
+- (void)orbitCaptureSessionInterruptionEnded:(NSNotification *)notification {
+    NSLog(@"[Orbit][Capture] session interruption ended");
+}
+
+- (void)orbitCaptureSessionRuntimeError:(NSNotification *)notification {
+    NSLog(@"[Orbit][Capture] session RUNTIME ERROR: %@",
+          notification.userInfo[AVCaptureSessionErrorKey]);
+}
