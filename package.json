{
  "name": "orbit-monorepo",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/server",
    "apps/mobile",
    "packages/shared"
  ],
  "scripts": {
    "postinstall": "patch-package",
    "dev:server": "npm run dev -w apps/server",
    "start:mobile": "npm run start -w apps/mobile",
    "build": "npm run build -w apps/server && npm run typecheck -w apps/mobile",
    "lint": "eslint apps/mobile/src",
    "test": "npm test -w apps/server"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-unused-imports": "^4.4.1",
    "patch-package": "^8.0.1"
  }
}
